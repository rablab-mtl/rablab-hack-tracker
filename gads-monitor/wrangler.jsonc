{
  // Worker rablab-gads-monitor (Module 2 du rablab-hack-tracker).
  // Deploiement : voir gads-monitor/README.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rablab-gads-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Cron toutes les 3 minutes : scan des change_event du MCC Google Ads.
  "triggers": {
    "crons": ["*/3 * * * *"]
  },

  // KV : config dynamique, dedup des events, whitelist, heartbeats des agents.
  // L'id est rempli automatiquement par "wrangler kv namespace create" (voir README).
  "kv_namespaces": [
    {
      "binding": "TRACKER_KV",
      "id": "fe3ca22fbf544076baa45ee7a9a890cc"
    }
  ],

  // Variables non sensibles (editables ici, visibles dans le dashboard Cloudflare).
  // CONFIDENTIALITE : la liste des emails de l'equipe, les comptes compromis et les users
  // Google Ads attendus ne sont PAS dans le repo public. Ils sont poses comme secrets :
  //   wrangler secret put EXPECTED_USERS         (liste des employes, page /status)
  //   wrangler secret put COMPROMISED_ACCOUNTS   (comptes compromis -> toujours 🚨)
  //   wrangler secret put GADS_EXPECTED_USERS    (operateurs Google Ads legitimes)
  // Voir gads-monitor/README.md.
  "vars": {
    // Version de l'API Google Ads. v18/v19 sont sunset (404). v20/v21/v22 valides (juin 2026).
    // A rebumper quand Google deprecie cette version.
    "GADS_API_VERSION": "v21",

    // Seuils de budget quotidien (en $) : BACKSTOP seulement. Le montant absolu n'est
    // qu'indicatif (vous avez plein de comptes avec des budgets varies). Les vrais
    // signaux 🚨 sont les operations NON HUMAINES (script/API/bulk) et les changements
    // DRASTIQUES (budget qui plus que triple), geres dans le code. Ajustez si besoin.
    "GADS_BUDGET_WARN_DAILY": "1000",
    "GADS_BUDGET_CRIT_DAILY": "5000",

    // Une hausse de budget par un humain (compte connu, via l'interface) passe en 🚨 si
    // le budget est multiplie par au moins ce facteur en une fois. 2 = double. Baisse a
    // 1.5 pour serrer davantage. (Hausses par script/API ou compte compromis = 🚨 d'office.)
    "GADS_BUDGET_SPIKE_FACTOR": "2",

    // Comptes scannes par tick de cron (toutes les 3 min). Limite par le plafond de
    // subrequests Cloudflare (50 sur le plan Free). Avec ~89 comptes, on tourne par
    // lots. Sur le plan Workers Paid (1000 subrequests), monter cette valeur pour tout
    // scanner a chaque tick.
    "GADS_SCAN_BATCH": "30"
  }
}
